# ProcessMonitor 환경변수 설정 예시 (.env.example)
# 실제 운영 시 본 파일을 .env 로 복사하여 값을 조정할 수 있습니다.

# 로컬 SQLite 데이터베이스 파일 경로 (기본값: ./data/app.db)
PROCESS_MONITOR_DB_PATH=./data/app.db

# 일별 로그 저장 폴더 경로 (기본값: ./logs)
PROCESS_MONITOR_LOG_DIR=./logs

# 프로세스 상태 점검 주기 (ms, 기본값: 2000)
PROCESS_MONITOR_CHECK_INTERVAL_MS=2000

# 기본 NTP 동기화 주기 (분, 기본값: 60)
PROCESS_MONITOR_NTP_INTERVAL_MIN=60

# 기본 1/2/3차 NTP 서버 목록 (콤마 구분)
PROCESS_MONITOR_NTP_SERVERS=time.bora.net,time.kriss.re.kr,pool.ntp.org
