{
  "system": {
    "runOnBoot": false,
    "minimizeToTray": true,
    "startMinimized": false,
    "checkIntervalMs": 2000,
    "logRetentionDays": 30,
    "maintenanceMode": false
  },
  "ntp": {
    "enabled": true,
    "syncIntervalMin": 1,
    "syncIntervalSec": 60,
    "timeoutMs": 2000,
    "maxOffsetLimitSec": 3600,
